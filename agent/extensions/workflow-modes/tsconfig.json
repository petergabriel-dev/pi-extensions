{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["sandbox.ts", "policy.ts", "plan-state.ts", "caveman.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
