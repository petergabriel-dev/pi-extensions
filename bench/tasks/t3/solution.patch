+/** Whole quantity with `,` thousands separators and a leading `-` when negative. */
+export function formatQty(qty: number): string {
+	const sign = qty < 0 ? "-" : "";
+	const digits = Math.abs(qty).toString();
+	return sign + digits.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+}
