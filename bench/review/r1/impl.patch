+++ b/test/shipped.test.ts
@@ -0,0 +1,18 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { totalShipped } from "../src/ledger.ts";
+import type { Movement } from "../src/types.ts";
+
+const movements: Movement[] = [
+	{ date: "2026-01-02", sku: "A-1", qty: 10, note: "" },
+	{ date: "2026-01-03", sku: "A-1", qty: -4, note: "" },
+	{ date: "2026-01-04", sku: "B-2", qty: -6, note: "" },
+];
+
+test("totalShipped sums shipments as a positive number", () => {
+	assert.equal(totalShipped(movements), 10);
+});
+
+test("totalShipped can filter by item code", () => {
+	assert.equal(totalShipped(movements, "a-1"), 4);
+});
