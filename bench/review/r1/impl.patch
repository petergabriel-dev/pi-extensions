diff --git a/src/ledger.ts b/src/ledger.ts
index 52c8a0a..16ca6ce 100644
--- a/src/ledger.ts
+++ b/src/ledger.ts
@@ -26,3 +26,14 @@ export function history(movements: Movement[], sku: string, range: DateRange = {
 export function lowStock(totals: Map<string, number>, threshold: number): string[] {
 	return [...totals.entries()].filter(([, qty]) => qty < threshold).map(([sku]) => sku);
 }
+
+/** Total quantity shipped, as a positive number, optionally for one item. */
+export function totalShipped(movements: Movement[], sku?: string): number {
+	const wanted = sku === undefined ? undefined : normalizeSku(sku);
+	let total = 0;
+	for (const movement of movements) {
+		if (wanted !== undefined && movement.sku !== wanted) continue;
+		if (movement.qty < 0) total += movement.qty;
+	}
+	return total;
+}
diff --git a/test/shipped.test.ts b/test/shipped.test.ts
new file mode 100644
