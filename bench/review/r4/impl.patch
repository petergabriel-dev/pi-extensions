-	return (from === undefined || date >= from) && (to === undefined || date <= to);
+/** Inclusive range check on `YYYY-MM-DD` strings; `month` keeps only that calendar month. */
+export function inRange(date: string, range: DateRange = {}): boolean {
+	if (range.month !== undefined && !date.startsWith(`${range.month}-`)) return false;
+	return (range.from === undefined || date >= range.from) && (range.to === undefined || date <= range.to);
 }
